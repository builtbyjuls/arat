{
  "name": "ui",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --configuration development",
    "generate:api-types": "openapi-typescript openapi/arat-v1.json -o src/app/api/generated/arat-api.ts",
    "prebuild": "npm run generate:api-types",
    "build": "ng build",
    "build:local-demo": "ng build --configuration local-demo",
    "lint": "ng lint",
    "pretest": "npm run generate:api-types",
    "test": "ng test --watch=false",
    "pretest:ci": "npm run generate:api-types",
    "test:ci": "ng test --watch=false --coverage",
    "test:browser": "playwright test",
    "test:browser:compose": "../scripts/test-ui-browser.sh",
    "verify:production-local-demo-exclusion": "node scripts/verify-production-local-demo-exclusion.mjs",
    "check": "npm run lint && npm run test:ci && npm run build && npm run verify:production-local-demo-exclusion"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": ">=24.15.0 <25.0.0"
  },
  "dependencies": {
    "@angular/common": "22.2.0",
    "@angular/compiler": "22.2.0",
    "@angular/core": "22.2.0",
    "@angular/forms": "22.2.0",
    "@angular/platform-browser": "22.2.0",
    "@angular/router": "22.2.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular-eslint/builder": "22.5.0",
    "@angular-eslint/eslint-plugin": "22.5.0",
    "@angular-eslint/eslint-plugin-template": "22.5.0",
    "@angular-eslint/template-parser": "22.5.0",
    "@angular/build": "22.2.0",
    "@angular/cli": "22.2.0",
    "@angular/compiler-cli": "22.2.0",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "5.0.1",
    "angular-eslint": "22.5.0",
    "eslint": "10.11.0",
    "jsdom": "30.0.0",
    "openapi-typescript": "7.13.0",
    "typescript": "6.0.2",
    "typescript-eslint": "8.70.1",
    "vitest": "5.0.1"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  }
}
